#!/bin/sh /etc/rc.common
#
# Hardware mode switch.
#
#   mt300n-moded    follows the switch next to the reset button and applies the
#                   selected mode (router / ap)
#   mt300n-apmode   AP-mode supervisor: keeps the bridge address and the
#                   wireless-only DHCP server in step with whatever is plugged
#                   into the LAN port
#
# Both run under procd and are restarted if they die.  mt300n-apmode idles while
# the router is not in AP mode, so it is always running and needs no start/stop
# logic of its own.
#
# Runs late in the boot sequence: the mode is applied after the network and wifi
# have come up, and it rewrites and reloads both.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance 'moded'
	procd_set_param command /usr/bin/mt300n-moded
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance

	procd_open_instance 'apmode'
	procd_set_param command /usr/bin/mt300n-apmode
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	restart
}
