#!/bin/sh /etc/rc.common
# frpc service.
#
# The binary lives in tmpfs and is fetched after boot, so like tailcat this
# script tolerates being asked to start before the payload exists. It also
# refuses to start when no serverAddr has been configured yet.

START=97
STOP=03
USE_PROCD=1

RUNNER=/usr/bin/mt300n-frpc-run

start_service() {
	[ -x /tmp/opt/bin/frpc ] || {
		logger -t frpc "binary not installed yet - waiting for the payload"
		return 0
	}

	# Validate the configuration before handing it to procd, so an
	# unconfigured frpc does not sit in a respawn loop.
	/usr/bin/mt300n-frpc-run --check >/dev/null 2>&1
	case "$?" in
		0) : ;;
		2) logger -t frpc "not configured - not starting"; return 0 ;;
		*) logger -t frpc "payload not ready - not starting"; return 0 ;;
	esac

	procd_open_instance
	procd_set_param command "$RUNNER"
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
