#!/bin/sh
# First-boot defaults for the GL.iNet GL-MT300N-V2 image.
# Runs once, from /etc/uci-defaults, then removes itself automatically.

. /lib/functions.sh

# --- hostname ---------------------------------------------------------------
uci -q batch <<-EOF
	set system.@system[0].hostname='GL-MT300N-V2'
	set system.@system[0].timezone='CST-8'
	set system.@system[0].zonename='Asia/Shanghai'
	commit system
EOF

# --- LEDs -------------------------------------------------------------------
# The stock configuration binds green:wan to the switch trigger. The status
# daemon owns that LED instead, so drop the conflicting entries. The power LED
# keeps the kernel default (steady on) and the wifi LED keeps its netdev trigger.
uci -q delete system.led_wan
uci -q delete system.led_power
uci -q commit system

# --- WAN --------------------------------------------------------------------
# Default is already dhcp; make it explicit and keep LAN on 192.168.1.1.
if uci -q get network.wan >/dev/null; then
	uci -q set network.wan.proto='dhcp'
	uci -q commit network
fi

# --- SSH --------------------------------------------------------------------
# The whole point of this image is that it stays remotely controllable: keep
# password auth on and make sure the admin key is present in BOTH locations
# dropbear may consult, so a `sysupgrade -n` (config reset) cannot lock us out.
uci -q batch <<-EOF
	set dropbear.@dropbear[0].PasswordAuth='on'
	set dropbear.@dropbear[0].RootPasswordAuth='on'
	set dropbear.@dropbear[0].Interface='lan'
	commit dropbear
EOF

mkdir -p /root/.ssh
chmod 700 /root/.ssh
if [ -f /etc/dropbear/authorized_keys ]; then
	cp /etc/dropbear/authorized_keys /root/.ssh/authorized_keys
	chmod 600 /etc/dropbear/authorized_keys /root/.ssh/authorized_keys
	chmod 700 /etc/dropbear
	logger -t mt300n "admin ssh key installed"
else
	logger -t mt300n "WARNING: no authorized_keys baked into the image"
fi

# Make sure the LAN bridge really is up with the documented default address.
if ! uci -q get network.lan.ipaddr >/dev/null; then
	uci -q set network.lan.ipaddr='192.168.1.1'
	uci -q set network.lan.netmask='255.255.255.0'
	uci -q commit network
fi

# --- services ---------------------------------------------------------------
/etc/init.d/glstatus enable
/etc/init.d/mt300n-payload enable

# --- zram swap ---------------------------------------------------------------
# The runtime payload lives in tmpfs on a 128 MB device; compressed swap keeps
# the router comfortable while both tailscaled and frpc are resident.
/etc/init.d/zram enable 2>/dev/null || true

exit 0
