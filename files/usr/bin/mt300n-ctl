#!/bin/sh
# mt300n-ctl - status and control helper for the GL-MT300N-V2 runtime payload.
#
# Used both from the shell and from LuCI (the web UI runs it through
# `ubus call file exec`). Output is either `key=value` lines (status) or plain
# text (logs), which is easy to parse on both sides.
#
#   mt300n-ctl status
#   mt300n-ctl payload [status|install]
#   mt300n-ctl frpc    [status|check|start|stop|restart|log [n]]
#   mt300n-ctl tailcat [status|start|stop|restart|log [n]|address|genkey|ping]

BIN=/tmp/opt/bin
ADDR_FILE=/etc/tailcat/address

CTL="$0"
case "$0" in */*) ;; *) CTL="/usr/bin/mt300n-ctl" ;; esac

have() { [ -x "$BIN/$1" ]; }
# Match on the full command line of the actual binary, so that the procd
# wrapper (/usr/bin/mt300n-*-run) or an init script in flight is not mistaken
# for a running service.
running() { pgrep -f "$1" >/dev/null 2>&1; }
RUNS_TAILCAT='bin/tailcat'
RUNS_FRPC='bin/frpc'
rss_kb() {
	_p=$(pgrep -f "$1" 2>/dev/null | head -1)
	[ -n "$_p" ] || return 1
	awk '/^VmRSS:/{print $2}' "/proc/$_p/status" 2>/dev/null
}

svc_state() {
	# $1 = init script name
	if [ -x "/etc/init.d/$1" ]; then
		/etc/init.d/"$1" status 2>&1 | grep -q running && echo 1 || echo 0
	else
		echo 0
	fi
}

# ------------------------------------------------------------------ payload --
payload_status() {
	echo "tailcat_installed=$(have tailcat && echo 1 || echo 0)"
	echo "frpc_installed=$(have frpc && echo 1 || echo 0)"
	echo "tailscale_installed=$(have tailscaled && echo 1 || echo 0)"
	[ -f /tmp/.mt300n-ready ] && echo "ready=1" || echo "ready=0"
	[ -f /tmp/.mt300n-installing ] && echo "installing=1" || echo "installing=0"
	[ -f /tmp/.mt300n-error ] && echo "error=1" || echo "error=0"
}

# ------------------------------------------------------------------- tailcat --
tailcat_status() {
	. /lib/functions.sh
	config_load tailcat
	config_get      role   main role 'serve'
	config_get      preset main preset 'ssh_web'
	config_get      custom main custom_ports ''
	config_get      region main region 'auto'
	config_get      keyn   main key_name 'default'
	config_get      faddr  main forward_addr ''
	config_get_bool en     main enabled 1

	echo "installed=$(have tailcat && echo 1 || echo 0)"
	echo "enabled=$en"
	echo "running=$(running "$RUNS_TAILCAT" && echo 1 || echo 0)"
	echo "pid=$(pgrep -f "$RUNS_TAILCAT" 2>/dev/null | head -1)"
	echo "role=$role"
	echo "preset=$preset"
	echo "custom_ports=$custom"
	echo "region=$region"
	echo "key_name=$keyn"
	echo "forward_addr=$faddr"
	if [ -f "$ADDR_FILE" ]; then
		echo "address=$(cat "$ADDR_FILE" 2>/dev/null)"
	fi
	_r=$(rss_kb "$RUNS_TAILCAT") && echo "rss_kb=$_r"
}

tailcat_log() { logread 2>/dev/null | grep -iE 'tailcat' | tail -n "${1:-40}"; }
frpc_log()    { logread 2>/dev/null | grep -iE 'frpc'    | tail -n "${1:-40}"; }

# ---------------------------------------------------------------------- frpc --
# frpc's own "verify" subcommand on the stored configuration. frpc answers a
# TOML syntax error with its YAML fallback message ("json: cannot unmarshal
# string into Go value of type v1.ClientConfig"), which hides the real problem,
# so the runner appends a hint on the second line. Both lines are reported.
frpc_check() {
	_out="$(/usr/bin/mt300n-frpc-run --verify 2>&1)"
	_rc=$?
	if [ "$_rc" = 0 ]; then
		echo "ok=1"
		echo "code=0"
	else
		echo "ok=0"
		echo "code=$_rc"
		printf '%s\n' "$_out" | sed -n '1p' | sed 's/^/error=/'
		printf '%s\n' "$_out" | sed -n '2p' | sed 's/^/hint=/'
	fi
}

frpc_status() {
	. /lib/functions.sh
	config_load frpc
	config_get_bool en main enabled 0
	_cfg="$(uci -q get frpc.main.config)"

	_conf=0
	if printf '%s\n' "$_cfg" | grep -qE '^[[:space:]]*serverAddr[[:space:]]*=[[:space:]]*"[^"]+"'; then
		_conf=1
	fi
	echo "installed=$(have frpc && echo 1 || echo 0)"
	echo "enabled=$en"
	echo "configured=$_conf"
	echo "running=$(running "$RUNS_FRPC" && echo 1 || echo 0)"
	echo "pid=$(pgrep -f "$RUNS_FRPC" 2>/dev/null | head -1)"
	_r=$(rss_kb "$RUNS_FRPC") && echo "rss_kb=$_r"
	# Only meaningful once the binary is there; frpc does the parsing.
	if have frpc && [ "$_conf" = 1 ]; then
		_chk="$(frpc_check)"
		echo "$_chk" | sed -n '1p'
		echo "$_chk" | sed -n '3p'   # error=... line, when there is one
	fi
}

# --------------------------------------------------------------------- mode ---
# Hardware mode switch state. mt300n-moded polls the switch and writes what it
# read to /tmp/mt300n-switch; mt300n-mode-apply records the mode it applied in
# /tmp/mt300n-mode.
mode_status() {
	local mode auto
	mode=$(cat /tmp/mt300n-mode 2>/dev/null); [ -n "$mode" ] || mode=unknown
	auto=$(uci -q get mt300n.main.auto); [ -n "$auto" ] || auto=1

	echo "mode=$mode"
	echo "auto=$auto"
	echo "switch=$(sed -n 's/^mode=//p' /tmp/mt300n-switch 2>/dev/null)"
	echo "btn0_gpio512=$(sed -n 's/^gpio512(BTN_0)=//p' /tmp/mt300n-switch 2>/dev/null)"
	echo "btn1_gpio515=$(sed -n 's/^gpio515(BTN_1)=//p' /tmp/mt300n-switch 2>/dev/null)"
	echo "ssid=$(uci -q get wireless.ap.ssid)"
	echo "lan_proto=$(uci -q get network.lan.proto)"

	if [ "$mode" = ap ]; then
		echo "ap_state=$(cat /tmp/mt300n-ap.state 2>/dev/null)"
		echo "ap_dhcp_pid=$(cat /tmp/mt300n-apdhcp.pid 2>/dev/null)"
		echo "ap_dhcp_range=$(sed -n 's/^dhcp-range=//p' /var/etc/mt300n-ap-dhcp.conf 2>/dev/null)"
		echo "lan_dhcp_blocked=$(nft list chain bridge mt300n input 2>/dev/null | grep -c 'iifname "eth0.1" udp dport 67')"
		echo "bridge_ports=$(ls /sys/class/net/br-lan/brif 2>/dev/null | tr '\n' ' ')"
	fi
}

# --------------------------------------------------------------------- main ---
case "$1" in
status)
	payload_status
	echo "---"
	tailcat_status
	echo "---"
	frpc_status
	echo "---"
	mode_status
	;;

mode)
	case "$2" in
	set)
		case "$3" in
		router|ap) ;;
		*) echo "usage: $0 mode set <router|ap> [auto|manual]" >&2; exit 2 ;;
		esac
		uci -q set mt300n.main.mode="$3"
		[ "$4" = "auto" ] && uci -q set mt300n.main.auto='1' \
				  || uci -q set mt300n.main.auto='0'
		uci -q commit mt300n
		/usr/bin/mt300n-mode-apply "$3"
		;;
	auto)
		uci -q set mt300n.main.auto='1'
		uci -q commit mt300n
		echo "mode now follows the hardware switch"
		;;
	selftest) /usr/bin/mt300n-selftest ;;
	*)        mode_status ;;
	esac
	;;

payload)
	case "$2" in
	install) /usr/sbin/mt300n-install ;;
	*)      payload_status ;;
	esac
	;;

tailcat)
	case "$2" in
	status)  tailcat_status ;;
	start)   /etc/init.d/tailcat start ;;
	stop)    /etc/init.d/tailcat stop ;;
	restart) /etc/init.d/tailcat restart ;;
	log)     tailcat_log "$3" ;;
	address)
		[ -f "$ADDR_FILE" ] && cat "$ADDR_FILE" || echo ""
		;;
	genkey)
		# Force a new saved key. The tailcat address changes.
		# The key lives at an absolute path under /etc: procd runs services with
		# HOME=/, so tailcat's own default key location would not survive a
		# reboot and every boot would mint a new address.
		export HOME=/root
		KEYN="$(uci -q get tailcat.main.key_name)"; [ -n "$KEYN" ] || KEYN=default
		REG="$(uci -q get tailcat.main.region)";   [ -n "$REG" ] || REG=auto
		FIX="$(uci -q get tailcat.main.fixed_region)"; [ -n "$FIX" ] || FIX=1
		KEYFILE="/etc/tailcat/keys/$KEYN.private.json"
		mkdir -p /etc/tailcat/keys; chmod 700 /etc/tailcat/keys 2>/dev/null
		DM="$(uci -q get tailcat.main.derpmap_url)"
		if [ -z "$DM" ]; then
			DM="http://127.0.0.1/derpmap.json"
			uclient-fetch -q -T 8 -O /dev/null "$DM" 2>/dev/null || \
				DM="https://ghfast.top/https://raw.githubusercontent.com/neroxps/openwrt-gl-mt300n-v2/payload/derpmap.json"
		fi
		pkill -f 'bin/tailcat' 2>/dev/null
		sleep 1
		rm -f "$KEYFILE"
		# Bake the region in (see mt300n-tailcat-run): only then is the printed
		# address constant across restarts.
		set -- genkey "--key=$KEYFILE" "--derpmap-url=$DM"
		[ "$REG" != "auto" ] && set -- "$@" "--region=$REG"
		[ "$FIX" = "1" ] && set -- "$@" --fixed-region
		"$BIN/tailcat" "$@" 2>&1 | tail -3
		uci -q set "tailcat.main.key_region=$REG/$FIX"
		uci -q commit tailcat
		/etc/init.d/tailcat restart >/dev/null 2>&1
		;;
	ping)
		# End-to-end tunnel self-test: connect to our own address as a client.
		ADDR="$(cat "$ADDR_FILE" 2>/dev/null)"
		[ -n "$ADDR" ] || { echo "no address yet"; exit 1; }
		DM="$(uci -q get tailcat.main.derpmap_url)"
		[ -n "$DM" ] || DM="http://127.0.0.1/derpmap.json"
		uclient-fetch -q -T 8 -O /dev/null "$DM" 2>/dev/null || \
			DM="https://ghfast.top/https://raw.githubusercontent.com/neroxps/openwrt-gl-mt300n-v2/payload/derpmap.json"
		"$BIN/tailcat" --derpmap-url="$DM" ping "$ADDR" 2>&1 | grep -iE 'pong|error|deadline' | tail -5
		;;
	*) echo "usage: $0 tailcat {status|start|stop|restart|log [n]|address|genkey|ping}" ;;
	esac
	;;

frpc)
	case "$2" in
	status)  frpc_status ;;
	check)   frpc_check ;;
	start)   /etc/init.d/frpc start ;;
	stop)    /etc/init.d/frpc stop ;;
	restart) /etc/init.d/frpc restart ;;
	log)     frpc_log "$3" ;;
	*) echo "usage: $0 frpc {status|check|start|stop|restart|log [n]}" ;;
	esac
	;;

*)
	cat <<EOF
usage: $0 <command>

  status                      everything at a glance
  payload [status|install]    payload state / (re)install it
  frpc    {status|check|start|stop|restart|log [n]}
                              check runs frpc's own verify on the stored TOML
  tailcat {status|start|stop|restart|log [n]|address|genkey|ping}
  mode    [status|set <router|ap> [auto|manual]|auto|selftest]
                              hardware switch mode; selftest proves that DHCP
                              is served to the wireless side only
EOF
	exit 1
	;;
esac
