#!/bin/sh
# Build the tailcat command line from /etc/config/tailcat and exec it.
#
# Kept separate from the init script so the very same logic runs whether
# tailcat is started by procd at boot, restarted from LuCI, or run by hand.
#
# Exit codes:
#   0  tailcat replaced this process (normal)
#   1  not installed yet  - the payload arrives after the WAN gets internet
#   2  misconfigured      - e.g. role=forward without an address

. /lib/functions.sh

BIN=/tmp/opt/bin/tailcat
ADDR_DIR=/etc/tailcat
ADDR_FILE=$ADDR_DIR/address

# IMPORTANT: the saved key is addressed by an ABSOLUTE PATH.
# procd runs services with HOME=/ (not /root), so tailcat's default key
# location ($HOME/.config/tailcat/keys) would point at /.config/... and the
# stable key generated interactively under /root would never be found - every
# boot would silently mint a fresh address. An explicit path removes the
# dependency on HOME entirely, and /etc survives a reboot.
KEYDIR=$ADDR_DIR/keys

# tailcat's built-in default (https://tailcat.dev/derpmap.json) is not
# reachable from every network, so we prefer a copy served by the router
# itself and fall back to the mirrored copy in this project's repository.
LOCAL_DERPMAP="http://127.0.0.1/derpmap.json"
REMOTE_DERPMAP="https://ghfast.top/https://raw.githubusercontent.com/neroxps/openwrt-gl-mt300n-v2/payload/derpmap.json"

export HOME=/root

log() { logger -t tailcat "$*"; }

config_load tailcat

config_get      role       main role 'serve'
config_get      preset     main preset 'ssh_web'
config_get      custom     main custom_ports ''
config_get      key_name   main key_name 'default'
config_get      region     main region 'auto'
config_get      key_region main key_region ''
config_get_bool fixed      main fixed_region 1
config_get      allow      main allow ''
config_get      sshkeys    main ssh_authorized_keys ''
config_get      fileshare  main files_share ''
config_get      faddr      main forward_addr ''
config_get      fmap       main forward_map ''
config_get      bind       main bind '127.0.0.1'
config_get      dmurl      main derpmap_url ''
config_get_bool verbose    main verbose 0
config_get      extra      main extra_args ''

[ -n "$key_name" ] || key_name=default
[ -n "$region" ]   || region=auto

# The region must be BAKED INTO THE KEY, not chosen at every startup.
#
# With a plain auto region tailcat re-probes at each start and the DERP
# information inside the printed address can differ between runs, so the
# "stable" address drifts by a character - which silently breaks every client
# that was given the previous one. --fixed-region discovers the nearest region
# once, at generation time, and bakes it in, making the address constant.
REGSPEC="$region/$fixed"

[ -x "$BIN" ] || { log "tailcat is not installed yet"; exit 1; }

mkdir -p "$ADDR_DIR" "$KEYDIR"
chmod 700 "$KEYDIR" 2>/dev/null

# ---------------------------------------------------------------- DERP map --
if [ -z "$dmurl" ]; then
	if uclient-fetch -q -T 8 -O /dev/null "$LOCAL_DERPMAP" 2>/dev/null; then
		dmurl="$LOCAL_DERPMAP"
	else
		dmurl="$REMOTE_DERPMAP"
	fi
fi

# --------------------------------------------------------------- saved key --
# A saved key is what makes the tailcat address stable across reboots.
KEYFILE="$KEYDIR/$key_name.private.json"

NEED_KEY=0
[ -f "$KEYFILE" ] || NEED_KEY=1
[ "$REGSPEC" != "$key_region" ] && NEED_KEY=1

if [ "$NEED_KEY" = "1" ]; then
	BACKUP=""
	if [ -f "$KEYFILE" ]; then
		# Keep the old key until a new one has actually been written: if genkey
		# fails we must not lose the stable address.
		BACKUP="$KEYFILE.bak"
		cp -f "$KEYFILE" "$BACKUP" 2>/dev/null
		log "DERP region changed ($key_region -> $REGSPEC); regenerating key (the address changes)"
	else
		log "generating saved key '$key_name' (region=$region fixed=$fixed)"
	fi

	_ok=0
	for _dm in "$dmurl" "$LOCAL_DERPMAP" "$REMOTE_DERPMAP"; do
		[ -n "$_dm" ] || continue
		# skip a source we already tried
		case " $_tried " in *" $_dm "*) continue ;; esac
		_tried="$_tried $_dm"

		rm -f "$KEYFILE"
		set -- genkey "--key=$KEYFILE" "--derpmap-url=$_dm"
		[ "$region" != "auto" ] && set -- "$@" "--region=$region"
		[ "$fixed" = "1" ] && set -- "$@" --fixed-region
		if _out=$("$BIN" "$@" 2>&1) && [ -f "$KEYFILE" ]; then
			_ok=1
			break
		fi
		log "genkey failed against $_dm: $(echo "$_out" | tail -2 | tr '\n' ' ')"
	done

	if [ "$_ok" = "1" ]; then
		rm -f "$BACKUP"
		uci -q set "tailcat.main.key_region=$REGSPEC"
		uci -q commit tailcat
	else
		log "genkey failed on every DERP map source"
		if [ -n "$BACKUP" ] && [ -f "$BACKUP" ]; then
			mv -f "$BACKUP" "$KEYFILE"
			log "restored the previous key so the address stays the same"
		else
			log "continuing with a fresh ephemeral address"
		fi
	fi
fi

# ------------------------------------------------------------ serve target --
svc=""
case "$preset" in
	ssh)         svc="22" ;;
	web)         svc="80,443" ;;
	ssh_web)     svc="22,80,443" ;;
	custom)      svc="$custom" ;;
	all)         svc="all" ;;
	tailcat_ssh) svc="ssh" ;;
	no_auth_ssh) svc="no-auth-ssh" ;;
	files)       svc="files" ;;
	exit_node)   svc="exit-node" ;;
	*)           svc="22,80,443" ;;
esac

# ------------------------------------------------------------------- argv ---
set -- "$BIN"
[ "$verbose" = "1" ] && set -- "$@" --verbose
set -- "$@" "--derpmap-url=$dmurl"

case "$role" in
forward)
	[ -n "$faddr" ] || { log "role=forward but forward_addr is empty"; exit 2; }
	[ -n "$fmap" ]  || { log "role=forward but forward_map is empty";  exit 2; }
	set -- "$@" "--key=$KEYFILE" forward "--bind=$bind" "$faddr"
	for m in $fmap; do
		set -- "$@" "$m"
	done
	[ -n "$extra" ] && set -- "$@" $extra
	;;
*)
	[ -n "$svc" ] || { log "no service configured"; exit 2; }
	[ -n "$allow" ] && set -- "$@" "--allow=$allow"
	if [ "$preset" = "tailcat_ssh" ] && [ -n "$sshkeys" ]; then
		set -- "$@" "--ssh-authorized-keys=$sshkeys"
	fi
	if [ -n "$fileshare" ]; then
		set -- "$@" "--files=$fileshare"
	fi
	set -- "$@" "--key=$KEYFILE" serve
	for s in $(echo "$svc" | tr ',' ' '); do
		set -- "$@" "$s"
	done
	[ -n "$extra" ] && set -- "$@" $extra
	;;
esac

# Publish the address where LuCI can read it, even while tailcat runs.
TAILCAT_ADDR_FILE="$ADDR_FILE"
export TAILCAT_ADDR_FILE

log "starting: $*"
exec "$@"
