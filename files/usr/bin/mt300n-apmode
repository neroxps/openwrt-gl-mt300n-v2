#!/bin/sh
#
# AP-mode supervisor.
#
# In AP mode the LAN port and the wifi are one bridge, and this router must only
# hand out addresses to the wireless side - and only when the bridge carries no
# upstream DHCP server of its own.  Two things have to be kept in step, and both
# depend on what is plugged into the LAN port at any given moment:
#
#   address    an upstream DHCP server means the router should take its address
#              from it, so the router stays reachable inside that network;
#              otherwise the bridge gets 192.168.1.1/24 locally.
#
#   DHCP       with an upstream server present this router stays silent.  With
#              none, it serves the wireless clients from a dedicated dnsmasq
#              instance.  OpenWrt's own dnsmasq cannot be scoped to a bridge
#              port, hence the separate instance; the LAN port itself is kept
#              out of reach by the nftables rule that mt300n-mode-apply installs.
#
# Detection of the upstream server is active, not passive, so it does not depend
# on somebody else asking for a lease: this router sends its own DISCOVER, with
# the vendor class MTPROBE, and the DHCP server it runs ignores that class.  A
# reply can therefore only have come from somebody else.
#
# The process idles while the router is not in AP mode.

. /lib/functions.sh

BR=br-lan
PROBE_VENDOR=MTPROBE
CONF=/var/etc/mt300n-ap-dhcp.conf
PIDFILE=/tmp/mt300n-apdhcp.pid
LEASEFILE=/tmp/mt300n-ap.leases
LOGFILE=/tmp/mt300n-apdhcp.log

log() { logger -t mt300n-apmode "$*"; }

apdhcp_stop() {
	local pid
	[ -f "$PIDFILE" ] && pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	rm -f "$PIDFILE"
}

apdhcp_running() {
	local pid
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

apdhcp_start() {
	local netmask

	apdhcp_running && return 0

	# 192.168.1.1/24 -> network 192.168.1.0, range 192.168.1.100-249
	NET=${AP_IP%.*}
	START=$NET.$AP_START
	END=$NET.$((AP_START + AP_LIMIT - 1))

	cat > "$CONF" <<EOF
# generated by mt300n-apmode - do not edit
port=0
interface=$BR
bind-dynamic
dhcp-range=$START,$END,255.255.255.0,$AP_LEASE
dhcp-option=3,$AP_IP
dhcp-option=6,$AP_IP
dhcp-authoritative
dhcp-leasefile=$LEASEFILE
pid-file=$PIDFILE
log-facility=$LOGFILE
log-dhcp
# never answer this router's own upstream probe
dhcp-vendorclass=set:probe,$PROBE_VENDOR
dhcp-ignore=tag:probe
EOF

	dnsmasq -C "$CONF" && log "wifi DHCP up: $START-$END via $AP_IP" \
		|| log "ERROR: could not start the wifi DHCP server"
}

# Ask the bridge for a lease.  Our own server ignores MTPROBE, so a reply means
# somebody else is serving DHCP out there.
probe_upstream() {
	rm -f /tmp/mt300n-ap-probe.pid
	udhcpc -i "$BR" -n -q -R -t 2 -T 2 -V "$PROBE_VENDOR" -s /bin/true \
		-p /tmp/mt300n-ap-probe.pid >/dev/null 2>&1
}

lan_has_lease() {
	ubus call network.interface.$1 status 2>/dev/null | grep -q '"address"'
}

to_upstream() {
	log "upstream DHCP server found - taking our address from it, our DHCP stays off"
	apdhcp_stop
	uci -q set network.lan.proto='dhcp'
	uci -q delete network.lan.ipaddr
	uci -q commit network
	ifup lan >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1
	echo upstream > /tmp/mt300n-ap.state
}

to_standalone() {
	log "no upstream DHCP server - serving the wireless side ourselves"
	uci -q set network.lan.proto='static'
	uci -q set network.lan.ipaddr="$AP_IPADDR"
	uci -q commit network
	ifup lan >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1
	apdhcp_start
	echo standalone > /tmp/mt300n-ap.state
}

cur_state() {
	case "$(uci -q get network.lan.proto)" in
		dhcp) echo upstream ;;
		*)    echo standalone ;;
	esac
}

config_load mt300n
config_get AP_IPADDR main ap_ipaddr '192.168.1.1/24'
config_get AP_START  main ap_start  '100'
config_get AP_LIMIT  main ap_limit  '150'
config_get AP_LEASE  main ap_leasetime '12h'
AP_IP=${AP_IPADDR%%/*}

oks=0
fails=0

while true; do
	if [ "$(cat /tmp/mt300n-mode 2>/dev/null)" != ap ]; then
		apdhcp_stop
		oks=0
		fails=0
		sleep 5
		continue
	fi

	st=$(cur_state)
	echo "$st" > /tmp/mt300n-ap.state

	if [ "$st" = standalone ]; then
		if apdhcp_running; then :; else apdhcp_start; fi

		if probe_upstream; then
			oks=$((oks + 1))
			fails=0
			[ "$oks" -ge 2 ] && { to_upstream; oks=0; }
		else
			oks=0
		fi
		# Slow enough not to chatter on somebody else's network, fast enough
		# that plugging the LAN port into a live network is noticed in well
		# under a minute (two consecutive probes are required).
		sleep 15
	else
		if lan_has_lease lan; then
			fails=0
		else
			fails=$((fails + 1))
			[ "$fails" -ge 3 ] && { to_standalone; fails=0; }
		fi
		sleep 15
	fi
done
