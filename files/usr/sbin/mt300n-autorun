#!/bin/sh
# mt300n-autorun - wait for internet, then install the payload.
#
# Started by /etc/init.d/mt300n-payload at every boot: the payload lives in
# tmpfs, so it has to be re-fetched after a reboot.
#
# This loops forever on purpose. An earlier revision gave up after 900s and
# exited, and because procd respawned it with the same 900s wait, a router
# whose uplink came up late could sit without tailcat/frpc for up to 15
# minutes. Polling continuously means the tools appear as soon as the WAN is
# usable - which is exactly when the LED is allowed to go solid.

READY=/tmp/.mt300n-ready
INSTALL=/usr/sbin/mt300n-install

log() { logger -t mt300n-autorun "$*"; }

# Already installed and something to run it? nothing to do.
if [ -f "$READY" ] && { [ -x /tmp/opt/bin/tailcat ] || [ -x /tmp/opt/bin/tailscaled ]; }; then
	log "payload already present"
	exit 0
fi

reachable() {
	ip route 2>/dev/null | grep -q '^default' || return 1
	ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1 && return 0
	ping -c 1 -W 2 1.1.1.1  >/dev/null 2>&1 && return 0
	return 1
}

log "waiting for internet (WAN dhcp)"
i=0
while :; do
	if reachable; then
		log "internet is up after $((i * 5))s"
		if "$INSTALL"; then
			log "install succeeded"
			exit 0
		fi
		log "install did not succeed - retrying in 60s"
		sleep 60
		i=$((i + 12))
		continue
	fi

	i=$((i + 1))
	# one line a minute keeps the log readable while offline
	[ $((i % 12)) -eq 0 ] && log "still no internet after $((i * 5))s"
	sleep 5
done
