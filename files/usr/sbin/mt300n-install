#!/bin/sh
# mt300n-install - bootstrap installer.
#
# Pulls install.sh and packages.txt from the GitHub software repository and
# runs it. Everything is fetched through a GitHub proxy (default
# https://ghfast.top) because raw github.com is unreliable on many networks.
#
# Overridable environment:
#   REPO=owner/name   PROXY=https://ghfast.top   REF=<tag or branch>

REPO="${REPO:-neroxps/openwrt-gl-mt300n-v2}"
PROXY="${PROXY:-https://ghfast.top}"
REF="${REF:-main}"

WORK=/tmp/mt300n-install
FLAG=/tmp/.mt300n-installing
READY=/tmp/.mt300n-ready
ERR=/tmp/.mt300n-error

mkdir -p "$WORK"
rm -f "$ERR"
: > "$FLAG"
/usr/bin/glstate installing

log() { logger -t mt300n-install "$*"; echo "$*"; }

# Is a usable payload already in place?
#
# /tmp/.mt300n-error has the highest priority in glstatusd, so it must only be
# set when the device really has no working payload. A bootstrap fetch that
# fails while the payload from an earlier run is intact (this uplink filters
# github and the proxy on 443 much of the time) is not a device failure - and
# if it painted the error state, the LED would stay wrong until the next
# successful install.
payload_usable() {
	[ -x /tmp/opt/bin/tailcat ] || return 1
	/tmp/opt/bin/tailcat version >/dev/null 2>&1 || return 1
	if [ -x /tmp/opt/bin/frpc ]; then
		/tmp/opt/bin/frpc -v >/dev/null 2>&1 || return 1
	fi
	return 0
}

# Cache buster.
#
# The GitHub proxies in front of raw.githubusercontent.com cache aggressively:
# a file pushed a moment ago is still served from cache for a while, which
# means a fix to install.sh itself would silently not take effect. A unique
# query string makes every fetch a cache miss.
CB="$(date +%s)$$"

fetch() {
	# $1 = url, $2 = output file
	if uclient-fetch -q -T 60 -O "$2" "$1" 2>/dev/null && [ -s "$2" ]; then
		return 0
	fi
	if wget -q -O "$2" "$1" 2>/dev/null && [ -s "$2" ]; then
		return 0
	fi
	return 1
}

log "repository : $REPO@$REF"
log "proxy      : $PROXY"

ok=0
for BASE in \
	"${PROXY}/https://raw.githubusercontent.com/${REPO}/${REF}" \
	"https://raw.githubusercontent.com/${REPO}/${REF}"
do
	PKGURL="${BASE}/payload/packages.txt?cb=${CB}"
	log "fetching $PKGURL"
	if fetch "$PKGURL" "$WORK/packages.txt"; then
		SHURL="${BASE}/payload/install.sh?cb=${CB}"
		log "fetching $SHURL"
		if fetch "$SHURL" "$WORK/install.sh"; then
			ok=1
			break
		fi
	fi
done

if [ "$ok" != "1" ]; then
	log "ERROR: cannot fetch the installer from $REPO@$REF"
	rm -f "$FLAG"
	if payload_usable; then
		log "the payload already installed is still usable - leaving the LED state alone"
		exit 0
	fi
	touch "$ERR"
	/usr/bin/glstate error
	exit 1
fi

log "package list:"
cat "$WORK/packages.txt"

REPO="$REPO" PROXY="$PROXY" REF="$REF" \
	sh "$WORK/install.sh" "$WORK/packages.txt"
rc=$?

rm -f "$FLAG"
if [ "$rc" -ne 0 ]; then
	log "install failed (rc=$rc)"
	if payload_usable; then
		log "the payload from an earlier run is intact and usable - leaving the state alone"
		exit 0
	fi
	touch "$ERR"
	rm -f "$READY"
	/usr/bin/glstate error
else
	log "install completed"
fi
exit "$rc"
