#!/bin/sh
# mt300n-wifi-uplink - temporarily connect the router to an upstream Wi-Fi AP
# so it has internet while the wired WAN port is unused.
#
#   mt300n-wifi-uplink on "Nero_Home" "461701018"
#   mt300n-wifi-uplink off
#
# `on` creates a station (client) virtual interface next to the existing access
# point - the MT7628 radio supports concurrent VAPs - and puts it in the `wan`
# firewall zone with a DHCP client, so it provides the default route exactly
# like the Ethernet WAN would.
#
# `off` removes every trace of the temporary configuration and restores the
# wired WAN zone membership, so the device goes back to WAN-over-Ethernet.

SECTION="mt300n_sta"

# The netifd interface name MUST match the wifi-iface's `network` option, that
# is how netifd binds the station device to an interface. Everything else
# (firewall zone membership, ifstatus lookups) uses the same name.
NET="wwan"

WAN_ZONE_DEFAULT="wan wan6"

log() { logger -t mt300n-wifi "$*"; echo "$*"; }

usage() {
	echo "usage: $0 on <ssid> [password] | off" >&2
	exit 1
}

find_wan_zone() {
	uci show firewall 2>/dev/null | \
		sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -1
}

wifi_reload() {
	wifi reload >/dev/null 2>&1 || wifi up >/dev/null 2>&1 || true
}

# Remove $NET from a zone's network list without disturbing other members.
zone_del() {
	_zn="$1"; _want="$2"
	_list="$(uci -q get "firewall.$_zn.network" 2>/dev/null)"
	[ -n "$_list" ] || return 0
	_keep=""
	for _x in $_list; do
		[ "$_x" = "$_want" ] && continue
		_keep="$_keep $_x"
	done
	uci -q delete "firewall.$_zn.network"
	for _x in $_keep; do
		uci -q add_list "firewall.$_zn.network=$_x"
	done
}

zone_add() {
	_zn="$1"; _want="$2"
	_list="$(uci -q get "firewall.$_zn.network" 2>/dev/null)"
	case " $_list " in
		*" $_want "*) return 0 ;;
	esac
	uci -q add_list "firewall.$_zn.network=$_want"
}

cleanup() {
	_zn="$(find_wan_zone)"

	while uci -q delete "wireless.$SECTION"; do :; done
	while uci -q delete "network.$NET"; do :; done

	if [ -n "$_zn" ]; then
		zone_del "$_zn" "$NET"
		for _w in $WAN_ZONE_DEFAULT; do
			zone_add "$_zn" "$_w"
		done
	fi

	uci -q commit network 2>/dev/null || true
	uci -q commit wireless 2>/dev/null || true
	uci -q commit firewall 2>/dev/null || true
}

# uci network interface name -> first IPv4 address, via netifd's own status
iface_addr() {
	ifstatus "$1" 2>/dev/null | sed -n 's/.*"address": "\([0-9.]*\)".*/\1/p' | head -1
}

case "$1" in
on)
	SSID="$2"
	KEY="$3"
	[ -n "$SSID" ] || usage

	log "configuring temporary Wi-Fi uplink to '$SSID'"
	cleanup

	RADIO="$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p" | head -1)"
	[ -n "$RADIO" ] || { log "ERROR: no radio found"; exit 1; }

	uci -q set "wireless.$SECTION=wifi-iface"
	uci -q set "wireless.$SECTION.device=$RADIO"
	uci -q set "wireless.$SECTION.mode=sta"
	uci -q set "wireless.$SECTION.ssid=$SSID"
	uci -q set "wireless.$SECTION.network=$NET"
	# Pin the created interface name. Without this the kernel device is named
	# phy0-sta0 and netifd cannot bind it to the interface (NO_DEVICE), so the
	# station associates but never gets a DHCP lease.
	uci -q set "wireless.$SECTION.ifname=$NET"
	if [ -n "$KEY" ]; then
		uci -q set "wireless.$SECTION.encryption=psk2"
		uci -q set "wireless.$SECTION.key=$KEY"
	else
		uci -q set "wireless.$SECTION.encryption=none"
	fi

	uci -q set "network.$NET=interface"
	uci -q set "network.$NET.proto=dhcp"

	_zn="$(find_wan_zone)"
	[ -n "$_zn" ] || _zn="@zone[1]"
	uci -q set "firewall.$_zn.name=wan"
	zone_add "$_zn" "$NET"

	uci -q commit wireless
	uci -q commit network
	uci -q commit firewall

	wifi_reload
	/etc/init.d/network reload >/dev/null 2>&1 || true

	i=0
	while [ "$i" -lt 40 ]; do
		ADDR="$(iface_addr "$NET")"
		if [ -n "$ADDR" ]; then
			log "uplink up: $NET has $ADDR"
			exit 0
		fi
		i=$((i + 1))
		sleep 3
	done

	log "ERROR: no DHCP lease on $NET after 120s"
	log "state: $(ifstatus $NET 2>&1 | tr -d '\n' | cut -c1-300)"
	exit 1
	;;

off)
	log "removing temporary Wi-Fi uplink"
	cleanup
	wifi_reload
	/etc/init.d/network reload >/dev/null 2>&1 || true
	log "done - WAN is back to Ethernet only"
	;;

*)
	usage
	;;
esac
